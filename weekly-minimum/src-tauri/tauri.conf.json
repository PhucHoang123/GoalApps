{
  "productName": "Weekly Minimum",
  "version": "1.0.0",
  "identifier": "com.weeklyminimum.desktop",
  "build": { "frontendDist": "../dist", "devUrl": "http://127.0.0.1:5173" },
  "app": {
    "windows": [
      {
        "title": "Weekly Minimum",
        "width": 920,
        "height": 760,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "useLocalToolsDir": true,
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Consistency without rigidity",
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
